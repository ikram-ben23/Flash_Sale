{
  "name": "flash-sale-api-secure",
  "version": "2.0.0",
  "private": true,
  "description": "Flash Sale REST API with authenticated orders, idempotency, PostgreSQL concurrency safety and integration tests",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test test/integration.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:stress": "node scripts/stress-test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  }
}